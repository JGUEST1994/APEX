# Copy to .env and edit. Never commit .env.
# SQLite works out of the box for a single-machine install; PostgreSQL is recommended for servers.
APEX_DATABASE_URL=sqlite:///./apex.db
# APEX_DATABASE_URL=postgresql+psycopg://apex:CHANGE_ME@localhost:5432/apex
APEX_ENV=development
# research | paper. There is deliberately no live mode in this release.
APEX_TRADING_MODE=research
APEX_LOG_LEVEL=INFO
APEX_LOG_JSON=false
# Seconds after which a feed is considered stale for intraday timeframes.
APEX_STALE_DATA_SECONDS=180
# Optional external AI (disabled by default; the platform never requires it).
APEX_AI_PROVIDER=none
